APP_NAME="Emerald Rozalia"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://emeraldrozalia.com/
APP_FORCE_HTTPS=true
TRUSTED_PROXIES=*
APP_TIMEZONE=Europe/Dublin
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IE
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=emerald_rozalia
DB_USERNAME=emerald_rozalia
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="Emerald Rozalia"

ADMIN_NAME="Project Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public footer values: set only in the live server .env.
BRAND_WHATSAPP=
BRAND_EMAIL=
BRAND_WEBSITE=
BRAND_LOCATION="Limerick, Ireland"

# Keep every external service false during deployment and initial go-live.
PAYMENT_LIVE_ENABLED=false
PAYMENT_PROVIDER=
PAYMENT_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
WHATSAPP_LIVE_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
SOCIAL_LIVE_ENABLED=false
SOCIAL_TOKEN=
SOCIAL_WEBHOOK_SECRET=
SHIPPING_LIVE_ENABLED=false
SHIPPING_PROVIDER=
SHIPPING_KEY=
SHIPPING_SECRET=
TRY_ON_LIVE_ENABLED=false
TRY_ON_ENDPOINT=
TRY_ON_KEY=
PRODUCT_360_LIVE_ENABLED=false

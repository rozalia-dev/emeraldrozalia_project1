[Unit]
Description=Emerald Rozalia WhatsApp Web Engine
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/emeraldrozalia_project1/services/whatsapp-engine
EnvironmentFile=/var/www/emeraldrozalia_project1/services/whatsapp-engine/.env
ExecStart=/usr/bin/node /var/www/emeraldrozalia_project1/services/whatsapp-engine/server.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
